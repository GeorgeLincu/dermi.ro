// Cloudflare Workers config — deployed by "Workers Builds: dermi" on every push to main.
// https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dermi",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  // Workers Builds installs npm dependencies; wrangler then runs this before deploying
  "build": { "command": "npm run build" },

  // Only reachable via dermi.ro — no workers.dev or preview URLs
  "workers_dev": false,
  "preview_urls": false,
  // Custom domains (Cloudflare creates the DNS records and certificates). www is redirected to the
  // apex by a zone Redirect Rule before it reaches the Worker.
  "routes": [
    { "pattern": "dermi.ro", "custom_domain": true },
    { "pattern": "www.dermi.ro", "custom_domain": true }
  ],

  "assets": {
    "directory": "./dist",
    // Serve /404.html with a real 404 status for unknown URLs
    "not_found_handling": "404-page",
    // /despre -> /despre/ (serves despre/index.html)
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    // The Worker handles only these paths; everything else is served straight from ./dist
    "run_worker_first": ["/api/*"]
  },

  // Contact form e-mail via Cloudflare Email Routing. Locked to ONE destination, which must be a
  // verified address in Email Routing → Destination addresses.
  "send_email": [
    { "name": "MAILER", "destination_address": "drmadalinalincu@gmail.com" }
  ],
  "vars": {
    "CONTACT_FROM": "formular@dermi.ro",
    "CONTACT_TO": "drmadalinalincu@gmail.com"
  },

  // At most 5 contact messages per minute per IP (free Workers rate-limiting binding)
  "ratelimits": [
    { "name": "CONTACT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],

  "observability": { "enabled": true }
}
