---
import Base from '../layouts/Base.astro';
import { useTranslations } from '../i18n/ui';
const t = useTranslations('ro');
---
<Base title="Pagina nu există | Dermi" description="Pagina căutată nu există pe dermi.ro." noindex>
  <div class="page">
    <div class="container container--narrow nf">
      <p class="nf__code" aria-hidden="true">404</p>
      <h1>{t('nf.title')}</h1>
      <p>{t('nf.body')}</p>
      <p class="hero__actions"><a href="/" class="btn btn--primary">{t('nf.back')}</a> <a href="/blog/" class="btn btn--ghost">Articole</a></p>
    </div>
  </div>
</Base>
