---
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/prose.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { CONFIG } from '../config';
import { translatedPath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
  title: string;
  description: string;
  ogImage?: string;
  ogTitle?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Markdown twin of this page for AI agents */
  markdown?: string;
}

const {
  lang = 'ro', title, description, ogImage = '/assets/og-image.png', ogTitle = title, type = 'website',
  noindex = false, jsonLd, publishedTime, modifiedTime, markdown,
} = Astro.props;

const t          = useTranslations(lang);
const path       = Astro.url.pathname;
const canonical  = new URL(path, CONFIG.site).href;
const ogImageUrl = new URL(ogImage, CONFIG.site).href;
const other      = translatedPath(path, lang === 'ro' ? 'en' : 'ro');
const roPath     = lang === 'ro' ? path : other;
const enPath     = lang === 'en' ? path : other;
const alternates = other && roPath && enPath
  ? [{ lang: 'ro', href: new URL(roPath, CONFIG.site).href }, { lang: 'en', href: new URL(enPath, CONFIG.site).href }]
  : [];
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content={CONFIG.doctor.name} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
  <meta name="theme-color" content="#14201c" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#f8f4ee" media="(prefers-color-scheme: light)" />
  <meta name="color-scheme" content="light dark" />
  <link rel="canonical" href={canonical} />
  {alternates.map(a => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
  {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
  <link rel="alternate" type="application/rss+xml" title="Dermi — articole" href="/rss.xml" />
  {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
  <link rel="help" type="text/plain" href="/llms.txt" title="Site summary for AI agents" />

  <meta property="og:type"         content={type} />
  <meta property="og:site_name"    content="Dermi" />
  <meta property="og:url"          content={canonical} />
  <meta property="og:title"        content={ogTitle} />
  <meta property="og:description"  content={description} />
  <meta property="og:image"        content={ogImageUrl} />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt"    content={ogTitle} />
  <meta property="og:locale"       content={lang === 'ro' ? 'ro_RO' : 'en_GB'} />
  {alternates.length > 0 && <meta property="og:locale:alternate" content={lang === 'ro' ? 'en_GB' : 'ro_RO'} />}
  {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
  {type === 'article' && <meta property="article:author" content={CONFIG.doctor.name} />}
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={ogTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImageUrl} />

  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Self-hosted fonts (no third-party requests) -->
  <link rel="preload" href="/assets/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/figtree.woff2"  as="font" type="font/woff2" crossorigin />

  <script is:inline src="/theme-init.js"></script>
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <a href="#main" class="skip-link">{t('a11y.skip')}</a>
  <Nav lang={lang} alternate={other} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer lang={lang} />
  <script>
    import '../scripts/site';
  </script>
</body>
</html>
