---
// The "mi" seal (Mădălina Iulia): monogram inside a ring — the same mark as the favicon.
interface Props { class?: string; size?: number }
const { class: cls = '', size } = Astro.props;
---
<svg class:list={['seal', cls]} viewBox="0 0 64 64" width={size} height={size} aria-hidden="true">
  <circle cx="32" cy="32" r="32" class="seal__bg" />
  <circle cx="32" cy="32" r="25" class="seal__ring" />
  <g class="seal__mi" transform="skewX(-12) translate(6.6 0)"><path d="M16 42.5V27.5M16 32c0-4.4 2.4-6.2 5-6.2s4.6 1.8 4.6 6.2v10.5M25.6 32c0-4.4 2.4-6.2 5-6.2s4.6 1.8 4.6 6.2v10.5M43.6 27.5v15" /></g>
  <circle cx="45.4" cy="19.6" r="2.9" class="seal__dot" />
</svg>
