---
import { useTranslations, type Lang } from '../i18n/ui';
interface Props { lang?: Lang }
const { lang = 'ro' } = Astro.props;
const t = useTranslations(lang);
---
<aside class="disclaimer" role="note" aria-label={t('disclaimer.title')}>
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M12 7.5v5.5M12 16.5v.01"/></svg>
  <p><strong>{t('disclaimer.title')}.</strong> {t('disclaimer.body')}</p>
</aside>
